# Copy to .env locally and set real values in your hosting provider for production.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_CSRF_TRUSTED_ORIGINS=

# Production PostgreSQL (set all values in your host environment)
POSTGRES_DB=freshers
POSTGRES_USER=freshers
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SSLMODE=

# Production SMTP (local DEBUG mode prints messages to the terminal)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Freshers Organizers <tickets@example.com>

# Match this value in the linked Google Sheet's Apps Script properties.
GOOGLE_FORMS_WEBHOOK_TOKEN=replace-with-a-long-random-shared-token
